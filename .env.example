# Local development profile (React + FastAPI + local Chroma path)
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

FEATURE_AUTH_ENABLED=true
FEATURE_COSMOS_DB_ENABLED=false
FEATURE_AZURE_OPENAI_ENABLED=false

USE_MOCK_AUTH=true
USE_MOCK_COSMOS=true
USE_MOCK_OPENAI=true
LOCAL_COSMOS_MOCK_FILE=local_cosmos_db.json/mock_cosmos_db.json

CHROMA_DB_PATH=./chroma_data
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=ukraine_invest_market_context

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-4-mini
AZURE_OPENAI_DEFAULT_DEPLOYMENT=gpt-5-4-mini
AZURE_OPENAI_ADVANCED_DEPLOYMENT=gpt-5-4-pro
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-03-01-preview

COSMOS_DB_CONNECTION_STRING=

ENTRA_CLIENT_ID=
ENTRA_AUTHORITY_URL=https://login.microsoftonline.com/
ENTRA_REDIRECT_URI=http://localhost:3000

AUTH_EMAIL_WHITELIST_FILE=src/auth/email_whitelist.txt
AUTH_TOKEN_SECRET=change_me_please_too
AUTH_TOKEN_TTL_MINUTES=1440
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_PBKDF2_ITERATIONS=200000

VITE_API_URL=http://localhost:8000
