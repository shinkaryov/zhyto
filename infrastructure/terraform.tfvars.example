# ============================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in your values
# ============================================================

azure_subscription_id = "your-subscription-id"
azure_tenant_id       = "your-tenant-id"
azure_location        = "polandcentral"

environment = "prod"

resource_group_name = "rg-zhyto-ukrinvest"

# ACR must be globally unique
container_registry_name = "acrzhytoukrinvest"
acr_sku                 = "Basic"
acr_admin_enabled       = false

# Backend Web App must be globally unique
web_app_name          = "app-zhyto-ukrinvest"
app_service_plan_name = "asp-zhyto-ukrinvest"
app_service_plan_sku  = "B1"

container_image_name = "ukraine-invest-backend"
container_image_tag  = "latest"

backend_health_check_path = "/health/ready"
backend_always_on         = true
chroma_mount_path         = "/mounts/chroma"

# Cosmos DB must be globally unique
cosmos_db_account_name = "cosmos-zhyto-ukrinvest"

# Key Vault must be globally unique
keyvault_name = "kv-zhyto-ukrinvest"

# Azure OpenAI account + deployments
openai_account_name          = "oaizhytoukrinvest"
openai_custom_subdomain_name = "oaizhytoukrinvest"
openai_account_sku_name      = "S0"

openai_default_deployment_name       = "gpt-5-4-mini"
openai_default_model_name            = "gpt-5.4-mini"
openai_default_model_version         = "2026-03-17"
openai_default_deployment_sku_name   = "GlobalStandard"
openai_default_deployment_sku_capacity = 1

openai_enable_advanced_deployment      = true
openai_advanced_deployment_name        = "gpt-5-4-advanced"
openai_advanced_model_name             = "gpt-5.4"
openai_advanced_model_version          = "2026-03-05"
openai_advanced_deployment_sku_name    = "GlobalStandard"
openai_advanced_deployment_sku_capacity = 1

openai_embedding_deployment_name       = "text-embedding-3-small"
openai_embedding_model_name            = "text-embedding-3-small"
openai_embedding_model_version         = "1"
openai_embedding_deployment_sku_name   = "GlobalStandard"
openai_embedding_deployment_sku_capacity = 1

# Storage account must be globally unique (no special chars)
storage_account_name  = "sazhytoukrinvest"
chroma_share_name     = "chroma-zhyto-ukrinvest"
chroma_share_quota_gb = 100
extra_storage_data_principal_object_ids = []
log_analytics_workspace_name = "log-zhyto-ukrinvest"
log_analytics_retention_days = 30

# App auth config
entra_redirect_uri = "http://localhost:3000"
auth_token_secret  = "set-this-to-a-random-long-secret"

common_tags = {
  Project     = "UkraineInvest"
  ManagedBy   = "Terraform"
  Environment = "production"
  CreatedDate = "2026"
}
